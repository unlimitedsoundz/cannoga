# ============================================================================
# Microsoft Azure Active Directory — Application Registration
# Required for SERVER-SIDE class provisioning, roster sync, and assignment mgmt.
# Delegated (student PKCE) login works WITHOUT these.
# ============================================================================
# Your Azure AD Tenant ID (Directory ID from Azure Portal)
AZURE_TENANT_ID=559051ae-ebf4-496a-8dbb-128aac57d721
# Your Azure AD Application (Client) ID — registered app for Cannoga SIS
AZURE_CLIENT_ID=your-azure-app-client-id
# Your Azure AD Client Secret — from Certificates & Secrets in Azure Portal
# NEVER commit this value. Store in secure environment variable only.
AZURE_CLIENT_SECRET=your-azure-client-secret

# Required Application Permissions (grant admin consent in Azure Portal):
#   EduRoster.ReadWrite.All     — Create classes, manage rosters
#   EduAssignments.ReadWrite.All — Create/update Microsoft assignments
#   Team.Create                  — Create Class Teams
#   Group.ReadWrite.All          — Manage Microsoft 365 groups
#   Sites.ReadWrite.All          — SharePoint course pages (optional)

# MiniMax Voice API
